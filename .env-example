CAMERA_MOTION_CONFIRM_FRAMES=2
CAMERA_MOTION_PRE_RECORD_SECONDS=10
CAMERA_MOTION_SEGMENT_SECONDS=2
CAMERA_WATCH_LOG_FILE=watch.log

# Use apenas se a camera ou outro servico entregar MJPEG/HTTP pronto.
CAMERA_STREAM_URL=
